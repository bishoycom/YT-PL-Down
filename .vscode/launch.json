{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Download Playlist",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/download.py",
      "cwd": "${workspaceFolder}",
      "args": [
        "${input:playlistUrl}",
        "--outdir",
        "${workspaceFolder}/downloads"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "playlistUrl",
      "type": "promptString",
      "description": "YouTube playlist URL to download",
      "default": ""
    }
  ]
}
